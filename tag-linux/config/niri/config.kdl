// include "dms/wpblur.kdl"
// include "dms/cursor.kdl"
// include "dms/outputs.kdl"
// include "dms/windowrules.kdl"

include "./noctalia.kdl"
include "./noctalia/config.kdl"
include "./noctalia/binds.kdl"
include "./noctalia/events.kdl"
